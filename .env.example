# Frontend API base path.
# Keep this as /backend for production. Vercel rewrites /backend to the cloud backend.
# In most cases, do not set this in Vercel because the code already defaults to /backend.
VITE_SCENEVERSE_API_BASE_URL=/backend

# Local dev only. This controls where Vite sends /backend requests.
# Cloud backend debugging:
VITE_SCENEVERSE_BACKEND_PROXY_TARGET=http://18.207.53.115
# Local backend debugging:
# VITE_SCENEVERSE_BACKEND_PROXY_TARGET=http://localhost:8000
