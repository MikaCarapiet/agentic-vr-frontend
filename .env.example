# Optional. Production defaults to /backend, which Vercel rewrites to the deployed FastAPI backend.
# For local backend testing, set this to http://localhost:8000.
VITE_SCENEVERSE_API_BASE_URL=/backend

# Optional. Local Vite proxy target for /backend.
# Defaults to the deployed EC2 backend when omitted.
# Set to http://localhost:8000 when running the FastAPI backend locally.
VITE_SCENEVERSE_BACKEND_PROXY_TARGET=http://18.207.53.115
