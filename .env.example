# Frontend API base path.
# Keep this as /backend for production. Vercel rewrites /backend to the cloud backend.
# In most cases, do not set this in Vercel because the code already defaults to /backend.
VITE_SCENEVERSE_API_BASE_URL=/backend

# Local dev profile switch. Default is local.
# local -> local backend, local SQLite, local media files
# cloud -> ECS backend, ECS SQLite, S3 media
SCENEVERSE_PROFILE=local
LOCAL_VITE_SCENEVERSE_BACKEND_PROXY_TARGET=http://localhost:8000
CLOUD_VITE_SCENEVERSE_BACKEND_PROXY_TARGET=http://18.207.53.115

# Optional escape hatch. Avoid this unless debugging a one-off backend target.
# VITE_SCENEVERSE_BACKEND_PROXY_TARGET=http://localhost:8000
